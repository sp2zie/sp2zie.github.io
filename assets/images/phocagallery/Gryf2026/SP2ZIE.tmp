<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01//EN" "http://www.w3.org/TR/html4/strict.dtd">
<html>
<head>
 <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
 <link rel="icon" type="image/png" href="/favicon.ico">
 <link href="?feed=atom" type="application/atom+xml" rel="alternate" title="SSDV Atom feed" />
 <style>

body {
	font-family: sans-serif;
	font-size: 8pt;
	background: #444;
	margin-top: 45px;
	color: #EEE;
}

a {
	color: #DC3;
	text-decoration: none;
}

#banner {
	position: fixed;
	left: 0px;
	top: 0px;
	background: #333;
	width: 100%;
	padding: 10px;
	font-size: 12pt;
	color: #999;
	
	-moz-box-shadow: 0px 0px 10px #FFF;
	-webkit-box-shadow: 0px 0px 10px #FFF;
	box-shadow: 0px 0px 10px #FFF;
}

#status {
	position: fixed;
	
	-moz-text-shadow: 1px 1px 1px #000;
	-webkit-text-shadow: 1px 1px 1px #000;
	text-shadow: 1px 1px 1px #000;
}

#info {
	position: fixed;
	right: 5pt;
	
	-moz-text-shadow: 1px 1px 1px #000;
	-webkit-text-shadow: 1px 1px 1px #000;
	text-shadow: 1px 1px 1px #000;
}

#images {
	padding: 15px 0 0 0;
	text-align: center;
}

#content {
	padding: 15px 10px 10px 10px;
	font-size: 14pt;
}

.json {
	border: 2px solid #333;
	background: #555;
	font-family: monospace;
	white-space: pre;
	padding: 10pt;
	margin: 10pt;
	/* Yay standards */
	-moz-tab-size: 2;
	tab-size: 2;
}

.json .comment {
	font-style: italic;
	color: #AAA;
	-webkit-touch-callout: none;
	-webkit-user-select: none;
	-khtml-user-select: none;
	-moz-user-select: none;
	-ms-user-select: none;
	user-select: none;
}

.parameters {
	border: 2px solid #333;
	background: #555;
	padding: 10pt;
	margin: 10pt;
	text-align: left;
}

.parameters td, .parameters tr {
	padding: 5pt;
}

.parameters td:first-child {
	font-family: monospace;
}

.photo {
	text-align: left;
	padding: 10px;
	margin: 10px;
	display: inline-table;
	background: #FFF;
	color: #000;
	
	border: none;
	-moz-border-radius: 10px;
	-webkit-border-radius: 10px;
	/*
	-opera-border-radius: 10px;
	-khtml-border-radius: 10px;
	*/
	border-radius: 10px;
	
	-moz-box-shadow: #000 0px 0px 12px;
	-webkit-box-shadow: #000 0px 0px 12px;
	box-shadow: #000 0px 0px 12px;
}

.thumbnail {
	border: 5px solid #FFF;
	border-radius: 5px;
	box-shadow: #000 0px 0px 6px;
	margin: auto 5px auto 5px;
}

.sel_payload {
	display: block;
	border-radius: 10px;
	padding: 2px 0px 10px 0px;
	margin: 0px auto 0px auto;
}

.sel_payload:hover {
	background: #555;
}

 </style>
 <script type="text/javascript">

var data_url = "\/update.php";
var payload  = "SP2ZIE";
var timezone = false;
var last_id  = 131582035;
var tseconds = 10;
var status   = false;

/* Preload Images */
preload = new Image();
preload.src = '/refresh.gif';

function load()
{
	setTimeout(refresh, tseconds * 1000);
}

async function refresh()
{
	status = '<img src="/refresh.gif" style="width: 12px; height: 12px; vertical-align: middle;" alt=""> Refreshing ...';
	document.querySelector('#status').innerHTML = status;
	
	try
	{
		const r = await fetch(data_url + '?format=json&request=update' + (payload ? '&payload=' + encodeURIComponent(payload) : '') + (timezone ? '&tz=' + encodeURIComponent(timezone) : '') + '&last_id=' + encodeURIComponent(last_id));
		const j = await r.json();
		update(j);
	}
	catch(error)
	{
		status = 'Error: ' + error;
	}
	
	document.querySelector('#status').innerHTML = status;
	setTimeout(refresh, tseconds * 1000);
}

function update(response)
{
	if(response == null)
	{
		status = 'No response from server';
		return;
	}
	
	tseconds = response.timer;
	if(tseconds < 10)
	{
		tseconds = 10;
	}
	
	var new_packets = response.last_id - last_id;
	last_id = response.last_id;
	
	if(new_packets < 0)
	{
		/* Unreceived a packet?? Reload the page */
		location.reload();
		return;
	}
	
	status = 'Received ' + new_packets + ' new packet' + (new_packets != 1 ? 's' : '') + (response.cache ? '' : ' *');
	
	if(new_packets == 0)
	{
		return;
	}
	
	/* One or more images have been updated.. reload */
	for(var i = response.images.length - 1; i >= 0; i--)
	{
		var image = response.images[i];
		var id = '#photo_' + image.id;
		
		if(document.querySelector(id) === null)
		{
			var d = document.createElement("div");
			d.innerHTML = image.html;
			
			var i = document.querySelector('#images');
			i.insertBefore(d.firstChild, i.firstChild);
		}
		else
		{
			/* Update the image caption details */
			document.querySelector(id + ' span.received').textContent = image.image_packets;
			document.querySelector(id + ' span.receivedq').textContent = (image.image_packets == 1 ? 'packet' : 'packets');
			document.querySelector(id + ' span.lost').textContent = image.lost_packets;
			document.querySelector(id + ' span.receivers').textContent = image.receivers.join(', ');
			
			/* Force the image to refresh */
			document.querySelector(id + ' img').src = image.image + '?u=' + image.image_packets;
		}
	}
}

 </script>
 <title>SSDV Live Images</title>
</head>
